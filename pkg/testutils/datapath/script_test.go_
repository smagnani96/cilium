		CiliumInternalIPv4:  net.ParseIP("192.0.2.3"),
		AllocCIDRIPv4:       cidr.MustParseCIDR("10.147.0.0/16"),
		ServiceLoopbackIPv4: net.ParseIP("192.0.2.3"),
		HostEndpointID:      1,
		EnableIPv4:          true,
		DeviceMTU:           1500,
	}
)

